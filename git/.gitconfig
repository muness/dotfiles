# Shared git config. Per-machine settings (signing program, tool machine ids)
# live in ~/.gitconfig.local, which the platform installer creates.
[user]
	name = Muness Castle
	email = 931+muness@users.noreply.github.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMRSHZRATaxhiO4JqlC4/kDIckCJO0zdw60iHP31+9MQ
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[pull]
	rebase = true
[core]
	excludesfile = ~/.config/git/ignore
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[include]
	path = ~/.gitconfig.local
